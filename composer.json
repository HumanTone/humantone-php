{
    "name": "humantone/humantone-php",
    "description": "Official PHP SDK for the HumanTone API. Humanize AI-generated text and check AI likelihood.",
    "type": "library",
    "license": "MIT",
    "keywords": ["humantone", "ai", "humanize", "ai-humanizer", "ai-detector", "nlp", "api-client"],
    "homepage": "https://humantone.io",
    "authors": [
        {
            "name": "HumanTone",
            "email": "dev@humantone.io",
            "homepage": "https://humantone.io"
        }
    ],
    "support": {
        "email": "dev@humantone.io",
        "issues": "https://github.com/humantone/humantone-php/issues",
        "docs": "https://humantone.io/docs/api/",
        "source": "https://github.com/humantone/humantone-php"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "HumanTone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HumanTone\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src/ --level=9",
        "fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
